<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/keyboard_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingTop="10dp"
    android:paddingRight="6dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="2"
        android:minHeight="44dp"
        android:text="@string/status_idle"
        android:textColor="@color/status_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp">

        <ImageButton
            android:id="@+id/mic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/mic_circle"
            android:backgroundTint="@color/mic_idle"
            android:contentDescription="@string/mic_start"
            android:scaleType="center"
            android:src="@drawable/ic_mic" />

        <ProgressBar
            android:id="@+id/spinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFF"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/key_switch"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/key_background"
            android:contentDescription="@string/key_switch"
            android:text="⌨"
            android:textColor="@color/key_text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/key_space"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/key_background"
            android:text="@string/key_space"
            android:textAllCaps="false"
            android:textColor="@color/key_text"
            android:textSize="16sp" />

        <Button
            android:id="@+id/key_delete"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:background="@drawable/key_background"
            android:contentDescription="@string/key_delete"
            android:text="⌫"
            android:textColor="@color/key_text"
            android:textSize="20sp" />

        <Button
            android:id="@+id/key_enter"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="match_parent"
            android:background="@drawable/key_background"
            android:contentDescription="@string/key_enter"
            android:text="⏎"
            android:textColor="@color/key_text"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
